<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Catarinense.API</RootNamespace>
    <UserSecretsId>catarinense-limpeza-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Catarinense.Domain\Catarinense.Domain.csproj" />
    <ProjectReference Include="..\Catarinense.Application\Catarinense.Application.csproj" />
    <ProjectReference Include="..\Catarinense.Infrastructure\Catarinense.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="7.2.0" />

    <!-- Leitura de planilhas Excel (.xlsx) na importação em lote de ônibus -->
    <PackageReference Include="ClosedXML" Version="0.104.2" />

    <!-- Necessário aqui (no projeto de startup) para o "dotnet ef migrations" funcionar -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    Regra de arquitetura: a API pode referenciar todas as camadas (composição raiz da
    aplicação), mas não deve conter regra de negócio — só orquestrar HTTP -> Use Case.
  -->

</Project>
